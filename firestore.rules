rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Store profile & Knowledge Base
    match /stores/{storeId} {
      allow read: if true;
      allow write: if false; // Updates managed via authenticated Admin SDK
    }

    // 2. Abandoned Checkouts
    match /abandoned_checkouts/{checkoutId} {
      allow read: if true;
      allow write: if false; // Written exclusively by Cloud Functions backend
    }

    // 3. Live Conversations & Messages
    match /conversations/{conversationId} {
      allow read: if true;
      allow write: if false; // Written exclusively by Cloud Functions backend
    }
  }
}
